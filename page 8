
:root {
    --ink: #172033;
    --muted: #687386;
    --accent: #6c63ff;
    --paper: #f5f6fb;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
}

/* Navigation */

header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #ffffffef;
    box-shadow: 0 3px 18px #18213a12;
}

.nav {
    max-width: 1120px;
    margin: auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.brand {
    font-size: 1.25rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--ink);
}

.brand span {
    color: var(--accent);
}

nav {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

nav a {
    color: #536078;
    text-decoration: none;
    padding: 9px 12px;
    border-radius: 9px;
    font-weight: 700;
    font-size: .92rem;
}

nav a:hover,
nav a.active {
    background: #eeedff;
    color: var(--accent);
}

/* Main content */

main {
    max-width: 1120px;
    margin: auto;
    padding: 36px 24px 60px;
}

/* Home hero section */

.hero {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 42px;
    min-height: 440px;
    padding: 42px;
    border-radius: 28px;
    color: white;
    background: linear-gradient(
        125deg,
        #171d35,
        #39366f 62%,
        #7168e8
    );
    overflow: hidden;
}

.eyebrow {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: .76rem;
    font-weight: 800;
    color: #c5c1ff;
}

h1 {
    font-size: clamp(2.5rem, 5vw, 4.3rem);
    line-height: 1.06;
    margin: 12px 0 18px;
}

.hero p {
    max-width: 520px;
    color: #e0e2f4;
    font-size: 1.05rem;
}

/* Buttons */

.btn {
    display: inline-block;
    margin-top: 16px;
    padding: 13px 22px;
    background: var(--accent);
    color: white;
    border: 0;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 800;
    cursor: pointer;
}

.btn.light {
    background: white;
    color: #37327c;
}

/* CSS smartwatch illustration */

.watch-art {
    min-height: 300px;
    display: grid;
    place-items: center;
}

.watch {
    width: 168px;
    height: 220px;
    border-radius: 42px;
    background: linear-gradient(145deg, #333b51, #111827);
    padding: 12px;
    box-shadow: 20px 25px 55px #080b1d88;
    transform: rotate(-9deg);
    position: relative;
}

.watch:before,
.watch:after {
    content: "";
    position: absolute;
    left: 36px;
    width: 96px;
    height: 95px;
    background: linear-gradient(110deg, #242c40, #111827);
    z-index: 0;
}

.watch:before {
    top: -85px;
    border-radius: 28px 28px 12px 12px;
}

.watch:after {
    bottom: -85px;
    border-radius: 12px 12px 28px 28px;
}

.screen {
    position: relative;
    z-index: 1;
    height: 100%;
    border-radius: 32px;
    background: radial-gradient(circle at 50% 35%, #313c72, #080d1c 70%);
    border: 2px solid #68728a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
}

.time {
    font-size: 2.15rem;
    font-weight: 800;
}

.date {
    font-size: .65rem;
    color: #bfc8ff;
}

.orb {
    margin-top: 17px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 5px solid #8b83ff;
    box-shadow: 0 0 22px #766cff;
}

/* Section headings */

.section-head {
    margin: 35px 0 24px;
}

.section-head h1,
.section-head h2 {
    font-size: 2.1rem;
    margin: 0 0 5px;
}

.section-head p {
    margin: 0;
    color: var(--muted);
}

/* Feature cards */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.card {
    background: white;
    border: 1px solid #e9ebf3;
    border-radius: 17px;
    padding: 23px;
    box-shadow: 0 8px 25px #20284a08;
}

.icon {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    background: #efeeff;
    color: var(--accent);
    border-radius: 12px;
    font-size: 1.35rem;
    margin-bottom: 13px;
}

.card h3 {
    margin: 0 0 7px;
}

.card p {
    color: var(--muted);
    margin: 0;
    font-size: .94rem;
}

/* Price section */

.price-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.price-card {
    background: white;
    padding: 30px;
    border-radius: 20px;
    border: 1px solid #e7e8f2;
}

.price-card.featured {
    color: white;
    background: linear-gradient(145deg, #292858, #7067e9);
    border: 0;
}

.price {
    font-size: 2.7rem;
    font-weight: 900;
    margin: 10px 0;
}

.price-card p {
    color: var(--muted);
}

.price-card.featured p {
    color: #e2e0ff;
}

.price-card ul {
    padding-left: 20px;
}

/* Specifications table */

.specs {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 16px;
    overflow: hidden;
}

.specs th,
.specs td {
    padding: 15px 18px;
    text-align: left;
    border-bottom: 1px solid #edf0f5;
}

.specs th {
    width: 38%;
    color: #4d5870;
    background: #fafaff;
}

/* Order form */

.order-layout {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 22px;
    align-items: start;
}

.order-note {
    background: linear-gradient(145deg, #292858, #7067e9);
    color: white;
    padding: 28px;
    border-radius: 18px;
}

.order-note p {
    color: #e2e0ff;
}

form {
    background: white;
    border: 1px solid #e8eaf2;
    border-radius: 18px;
    padding: 26px;
}

label {
    display: block;
    font-weight: 700;
    margin: 12px 0 6px;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px 13px;
    border: 1px solid #dce0eb;
    border-radius: 9px;
    font: inherit;
    background: white;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #c8c4ff;
    border-color: var(--accent);
}

.submit {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 14px;
    margin-top: 18px;
    color: white;
    background: var(--accent);
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
}

.notice {
    display: none;
    margin-top: 14px;
    padding: 12px;
    border-radius: 9px;
    background: #e9f8ef;
    color: #17663a;
}

/* Contact section */

.contact {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.muted {
    color: var(--muted);
}

/* Footer */

footer {
    text-align: center;
    color: #788196;
    padding: 24px;
    border-top: 1px solid #e6e8f0;
    background: white;
}

/* Responsive design */

@media(max-width: 760px) {

    .nav {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
    }

    nav {
        gap: 3px;
    }

    nav a {
        padding: 8px 9px;
    }

    main {
        padding: 20px 14px 40px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 30px 24px;
        gap: 8px;
    }

    .watch-art {
        min-height: 260px;
    }

    .cards {
        grid-template-columns: 1fr 1fr;
    }

    .price-wrap,
    .order-layout {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 480px) {

    .cards,
    .contact {
        grid-template-columns: 1fr;
    }

    nav a {
        font-size: .82rem;
    }

    .hero {
        border-radius: 18px;
    }
}
